{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ATYL read-only GGUF metadata observation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "source",
    "gguf_version",
    "tensor_count_in_this_file",
    "metadata_key_count",
    "general",
    "architecture_metadata",
    "tensor_type_id_counts",
    "split",
    "metadata_bytes_scanned",
    "validation",
    "limitations"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "kind": {
      "const": "gguf_metadata_observation"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "filename",
        "file_size_bytes"
      ],
      "properties": {
        "filename": {
          "type": "string",
          "minLength": 1
        },
        "file_size_bytes": {
          "type": "integer",
          "minimum": 24
        }
      }
    },
    "gguf_version": {
      "enum": [
        2,
        3
      ]
    },
    "tensor_count_in_this_file": {
      "type": "integer",
      "minimum": 0
    },
    "metadata_key_count": {
      "type": "integer",
      "minimum": 0
    },
    "general": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "architecture",
        "name",
        "file_type_id",
        "quantization_version"
      ],
      "properties": {
        "architecture": {
          "type": [
            "string",
            "null"
          ]
        },
        "name": {
          "type": [
            "string",
            "null"
          ]
        },
        "file_type_id": {
          "type": [
            "integer",
            "null"
          ]
        },
        "quantization_version": {
          "type": [
            "integer",
            "null"
          ]
        }
      }
    },
    "architecture_metadata": {
      "type": "object",
      "additionalProperties": {
        "type": [
          "integer",
          "number",
          "string",
          "boolean"
        ]
      }
    },
    "tensor_type_id_counts": {
      "type": "object",
      "patternProperties": {
        "^[0-9]+$": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false
    },
    "split": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "part_index",
        "part_count",
        "total_tensor_count_reported",
        "multiple_parts_reported",
        "all_parts_inspected"
      ],
      "properties": {
        "part_index": {
          "type": [
            "integer",
            "null"
          ]
        },
        "part_count": {
          "type": [
            "integer",
            "null"
          ]
        },
        "total_tensor_count_reported": {
          "type": [
            "integer",
            "null"
          ]
        },
        "multiple_parts_reported": {
          "type": "boolean"
        },
        "all_parts_inspected": {
          "const": false
        }
      }
    },
    "metadata_bytes_scanned": {
      "type": "integer",
      "minimum": 24
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "metadata_structure_parsed",
        "tensor_descriptors_parsed",
        "tensor_data_read",
        "tensor_payload_integrity_verified",
        "model_load_tested",
        "model_backend_compatibility"
      ],
      "properties": {
        "metadata_structure_parsed": {
          "const": true
        },
        "tensor_descriptors_parsed": {
          "const": true
        },
        "tensor_data_read": {
          "const": false
        },
        "tensor_payload_integrity_verified": {
          "const": false
        },
        "model_load_tested": {
          "const": false
        },
        "model_backend_compatibility": {
          "const": "not_tested"
        }
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    }
  }
}
