{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ATYL speculative model-pair preflight v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "artifact_id",
    "mode",
    "target",
    "draft",
    "checks",
    "status",
    "executable",
    "reasons",
    "limitations"
  ],
  "properties": {
    "schema_version": {"const": "0.1.0"},
    "kind": {"const": "speculative_model_pair_preflight"},
    "artifact_id": {"type": "string", "minLength": 1},
    "mode": {"enum": ["external_mtp", "external_draft_simple"]},
    "target": {"$ref": "#/$defs/model"},
    "draft": {"$ref": "#/$defs/model"},
    "checks": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "full_file_digests_match_profile",
        "both_inputs_are_single_file_gguf",
        "architecture_match",
        "tokenizer_metadata_byte_equivalent"
      ],
      "properties": {
        "full_file_digests_match_profile": {"const": true},
        "both_inputs_are_single_file_gguf": {"const": true},
        "architecture_match": {"type": "boolean"},
        "tokenizer_metadata_byte_equivalent": {"type": "boolean"}
      }
    },
    "status": {"enum": ["blocked", "requires_runtime_load_verification"]},
    "executable": {"const": false},
    "reasons": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "limitations": {"type": "array", "minItems": 1, "items": {"type": "string"}}
  },
  "$defs": {
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["filename", "file_size_bytes", "sha256", "architecture", "metadata_sha256", "tokenizer_metadata", "split"],
      "properties": {
        "filename": {"type": "string", "minLength": 1},
        "file_size_bytes": {"type": "integer", "minimum": 24},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "architecture": {"type": ["string", "null"]},
        "metadata_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "tokenizer_metadata": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "metadata_key_count", "metadata_sha256"],
          "properties": {
            "status": {"enum": ["observed", "unknown"]},
            "metadata_key_count": {"type": "integer", "minimum": 0},
            "metadata_sha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"}
          }
        },
        "split": {
          "type": "object",
          "additionalProperties": false,
          "required": ["part_index", "part_count", "total_tensor_count_reported", "multiple_parts_reported", "all_parts_inspected"],
          "properties": {
            "part_index": {"type": ["integer", "null"]},
            "part_count": {"type": ["integer", "null"]},
            "total_tensor_count_reported": {"type": ["integer", "null"]},
            "multiple_parts_reported": {"type": "boolean"},
            "all_parts_inspected": {"const": false}
          }
        }
      }
    }
  }
}
