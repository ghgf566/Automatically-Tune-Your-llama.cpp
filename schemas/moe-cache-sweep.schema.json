{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atyl.local/schemas/moe-cache-sweep.schema.json",
  "title": "ATYL bounded MoE GPU expert cache sweep",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "created_at_utc", "status", "engine_sha256", "engine_version_excerpt", "model", "configuration", "workload", "sweep", "cases", "summary", "limitations"],
  "properties": {
    "schema_version": {"const": "0.1.0"},
    "kind": {"const": "moe_gpu_expert_cache_sweep"},
    "created_at_utc": {"type": "string", "minLength": 1},
    "status": {"enum": ["prepared_not_executed", "running", "completed", "incomplete"]},
    "engine_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "engine_version_excerpt": {"type": "string", "maxLength": 500},
    "model": {
      "type": "object", "additionalProperties": false,
      "required": ["filename", "file_size_bytes", "architecture", "expert_count", "sha256"],
      "properties": {
        "filename": {"type": "string", "minLength": 1},
        "file_size_bytes": {"type": "integer", "minimum": 1},
        "architecture": {"type": "string", "minLength": 1},
        "expert_count": {"type": "integer", "minimum": 1},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "configuration": {
      "type": "object", "additionalProperties": false,
      "required": ["device_id", "gpu_layers", "cpu_moe", "cache_type_k", "cache_type_v", "context_tokens", "concurrency", "fit", "prompt_cache_ram_mib", "device_reserve_mib", "host_reserve_mib", "batch_size", "ubatch_size"],
      "properties": {
        "device_id": {"type": "string", "minLength": 1},
        "gpu_layers": {"type": "integer", "minimum": 0},
        "cpu_moe": {"const": true},
        "cache_type_k": {"enum": ["f32", "f16", "bf16", "q8_0", "q4_0", "q4_1", "iq4_nl", "q5_0", "q5_1"]},
        "cache_type_v": {"enum": ["f32", "f16", "bf16", "q8_0", "q4_0", "q4_1", "iq4_nl", "q5_0", "q5_1"]},
        "context_tokens": {"type": "integer", "minimum": 1},
        "concurrency": {"const": 1},
        "fit": {"const": "off"},
        "prompt_cache_ram_mib": {"const": 0},
        "device_reserve_mib": {"type": "integer", "minimum": 1},
        "host_reserve_mib": {"type": "integer", "minimum": 0},
        "batch_size": {"type": "integer", "minimum": 1},
        "ubatch_size": {"type": "integer", "minimum": 1}
      }
    },
    "workload": {
      "type": "object", "additionalProperties": false,
      "required": ["workload_id", "prompt_sha256", "n_predict", "warmup_requests", "repetitions_per_case", "seed"],
      "properties": {
        "workload_id": {"const": "moe_cache_synthetic"},
        "prompt_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "n_predict": {"type": "integer", "minimum": 16},
        "warmup_requests": {"type": "integer", "minimum": 0, "maximum": 3},
        "repetitions_per_case": {"type": "integer", "minimum": 1, "maximum": 30},
        "seed": {"type": "integer"}
      }
    },
    "sweep": {
      "type": "object", "additionalProperties": false,
      "required": ["cache_candidates_mib", "execution_order_cache_mib", "case_count", "timeout_seconds_per_case", "max_total_seconds"],
      "properties": {
        "cache_candidates_mib": {"type": "array", "minItems": 1, "maxItems": 6, "items": {"type": "integer", "minimum": 0, "maximum": 16384}, "uniqueItems": true},
        "execution_order_cache_mib": {"type": "array", "minItems": 1, "maxItems": 6, "items": {"type": "integer", "minimum": 0, "maximum": 16384}, "uniqueItems": true},
        "case_count": {"type": "integer", "minimum": 1, "maximum": 6},
        "timeout_seconds_per_case": {"type": "integer", "minimum": 1, "maximum": 1800},
        "max_total_seconds": {"type": "integer", "minimum": 1, "maximum": 21600}
      }
    },
    "cases": {
      "type": "array", "minItems": 1, "maxItems": 6,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["case_id", "moe_cache_mib", "status", "measurement", "argv_redacted"],
        "properties": {
          "case_id": {"type": "string", "minLength": 1},
          "moe_cache_mib": {"type": "integer", "minimum": 0, "maximum": 16384},
          "status": {"enum": ["prepared_not_executed", "completed", "reserve_rejected", "reserve_exceeded", "load_failed", "timeout", "budget_exhausted", "benchmark_failed", "input_identity_changed", "not_run"]},
          "measurement": {"type": ["object", "null"]},
          "argv_redacted": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "summary": {
      "type": ["object", "null"], "additionalProperties": false,
      "required": ["case_count", "completed_case_count", "incomplete_case_count", "stop_reason", "elapsed_seconds", "winner_selection"],
      "properties": {
        "case_count": {"type": "integer", "minimum": 1, "maximum": 6},
        "completed_case_count": {"type": "integer", "minimum": 0, "maximum": 6},
        "incomplete_case_count": {"type": "integer", "minimum": 0, "maximum": 6},
        "stop_reason": {"type": ["string", "null"]},
        "elapsed_seconds": {"type": "number", "minimum": 0},
        "winner_selection": {"type": "string", "minLength": 1}
      }
    },
    "limitations": {"type": "array", "minItems": 1, "items": {"type": "string"}}
  }
}
