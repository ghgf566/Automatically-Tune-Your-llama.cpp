{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ATYL single-candidate llama fit-params memory estimate plan v0.3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "status",
    "engine_sha256",
    "model",
    "candidate",
    "argv",
    "estimate",
    "limitations",
    "environment"
  ],
  "properties": {
    "schema_version": {
      "const": "0.3.0"
    },
    "kind": {
      "const": "fit_estimate_plan"
    },
    "status": {
      "enum": [
        "prepared_not_executed",
        "estimate_attempted"
      ]
    },
    "engine_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "filename",
        "file_size_bytes",
        "architecture",
        "gguf_version"
      ],
      "properties": {
        "filename": {
          "type": "string"
        },
        "file_size_bytes": {
          "type": "integer",
          "minimum": 24
        },
        "architecture": {
          "type": [
            "string",
            "null"
          ]
        },
        "gguf_version": {
          "enum": [
            2,
            3
          ]
        }
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "device_id",
        "context_tokens",
        "gpu_layers",
        "fit_adjustment",
        "output_mode"
      ],
      "properties": {
        "device_id": {
          "type": "string",
          "minLength": 1
        },
        "context_tokens": {
          "type": "integer",
          "minimum": 128,
          "maximum": 262144
        },
        "gpu_layers": {
          "type": "integer",
          "minimum": 0
        },
        "fit_adjustment": {
          "const": "off"
        },
        "output_mode": {
          "const": "estimated_memory"
        }
      }
    },
    "argv": {
      "type": "array",
      "minItems": 15,
      "maxItems": 15,
      "items": {
        "type": "string"
      }
    },
    "estimate": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "returncode",
            "stdout_excerpt",
            "stderr_excerpt",
            "output_truncated_or_unknown",
            "estimate_unit",
            "parsed_numeric_memory",
            "model_load_tested",
            "inference_tested"
          ],
          "properties": {
            "status": {
              "enum": [
                "completed",
                "nonzero_exit",
                "timeout",
                "process_error",
                "output_limit"
              ]
            },
            "returncode": {
              "type": [
                "integer",
                "null"
              ]
            },
            "stdout_excerpt": {
              "type": "string"
            },
            "stderr_excerpt": {
              "type": "string"
            },
            "output_truncated_or_unknown": {
              "type": "boolean"
            },
            "estimate_unit": {
              "type": "string"
            },
            "parsed_numeric_memory": {
              "oneOf": [
                {
                  "type": "null"
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "status",
                    "unit",
                    "devices",
                    "host",
                    "estimated_total_mib",
                    "model_load_tested",
                    "inference_tested"
                  ],
                  "properties": {
                    "status": {
                      "const": "parsed"
                    },
                    "unit": {
                      "const": "MiB"
                    },
                    "devices": {
                      "type": "array",
                      "maxItems": 32,
                      "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "device_id",
                          "model_mib",
                          "context_mib",
                          "compute_mib",
                          "estimated_total_mib"
                        ],
                        "properties": {
                          "device_id": {
                            "type": "string",
                            "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$"
                          },
                          "model_mib": {
                            "type": "integer",
                            "minimum": 0
                          },
                          "context_mib": {
                            "type": "integer",
                            "minimum": 0
                          },
                          "compute_mib": {
                            "type": "integer",
                            "minimum": 0
                          },
                          "estimated_total_mib": {
                            "type": "integer",
                            "minimum": 0
                          }
                        }
                      }
                    },
                    "host": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "model_mib",
                        "context_mib",
                        "compute_mib",
                        "estimated_total_mib"
                      ],
                      "properties": {
                        "model_mib": {
                          "type": "integer",
                          "minimum": 0
                        },
                        "context_mib": {
                          "type": "integer",
                          "minimum": 0
                        },
                        "compute_mib": {
                          "type": "integer",
                          "minimum": 0
                        },
                        "estimated_total_mib": {
                          "type": "integer",
                          "minimum": 0
                        }
                      }
                    },
                    "estimated_total_mib": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "model_load_tested": {
                      "const": false
                    },
                    "inference_tested": {
                      "const": false
                    }
                  }
                }
              ]
            },
            "model_load_tested": {
              "const": false
            },
            "inference_tested": {
              "const": false
            }
          }
        }
      ]
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scenario",
        "scenario_is_user_declared",
        "background_note",
        "capture_status",
        "before",
        "after",
        "available_memory_change"
      ],
      "properties": {
        "scenario": {
          "enum": [
            "daily",
            "reduced_background"
          ]
        },
        "scenario_is_user_declared": {
          "const": true
        },
        "background_note": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 300
        },
        "capture_status": {
          "enum": [
            "not_sampled",
            "captured_best_effort"
          ]
        },
        "before": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/sample"
            }
          ]
        },
        "after": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/sample"
            }
          ]
        },
        "available_memory_change": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/change"
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "capture_status": {
                "const": "not_sampled"
              }
            }
          },
          "then": {
            "properties": {
              "before": {
                "type": "null"
              },
              "after": {
                "type": "null"
              },
              "available_memory_change": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "capture_status": {
                "const": "captured_best_effort"
              }
            }
          },
          "then": {
            "properties": {
              "before": {
                "type": "object"
              },
              "after": {
                "type": "object"
              },
              "available_memory_change": {
                "type": "object"
              }
            }
          }
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "prepared_not_executed"
          }
        }
      },
      "then": {
        "properties": {
          "estimate": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "estimate_attempted"
          }
        }
      },
      "then": {
        "properties": {
          "estimate": {
            "type": "object"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "prepared_not_executed"
          }
        }
      },
      "then": {
        "properties": {
          "environment": {
            "properties": {
              "capture_status": {
                "const": "not_sampled"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "estimate_attempted"
          }
        }
      },
      "then": {
        "properties": {
          "environment": {
            "properties": {
              "capture_status": {
                "const": "captured_best_effort"
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "mem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "reason",
        "total_mib",
        "available_mib"
      ],
      "properties": {
        "status": {
          "enum": [
            "observed",
            "unknown"
          ]
        },
        "reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "total_mib": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "available_mib": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        }
      }
    },
    "gpu": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "reason",
        "device_id",
        "backend_id",
        "description",
        "total_mib",
        "available_mib"
      ],
      "properties": {
        "status": {
          "enum": [
            "observed",
            "unknown",
            "not_requested"
          ]
        },
        "reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "device_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "backend_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "description": {
          "type": [
            "string",
            "null"
          ]
        },
        "total_mib": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "available_mib": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        }
      }
    },
    "sample": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "timestamp_utc",
        "ram",
        "gpu"
      ],
      "properties": {
        "timestamp_utc": {
          "type": "string",
          "format": "date-time"
        },
        "ram": {
          "$ref": "#/$defs/mem"
        },
        "gpu": {
          "$ref": "#/$defs/gpu"
        }
      }
    },
    "change": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "system_ram_available_delta_mib",
        "gpu_available_delta_mib",
        "peak_gpu_usage_mib",
        "peak_ram_usage_mib",
        "attribution",
        "model_load_status"
      ],
      "properties": {
        "system_ram_available_delta_mib": {
          "type": [
            "integer",
            "null"
          ]
        },
        "gpu_available_delta_mib": {
          "type": [
            "integer",
            "null"
          ]
        },
        "peak_gpu_usage_mib": {
          "type": "null"
        },
        "peak_ram_usage_mib": {
          "type": "null"
        },
        "attribution": {
          "const": "unknown_background_load_and_driver_effects"
        },
        "model_load_status": {
          "const": "not_tested"
        }
      }
    }
  }
}
